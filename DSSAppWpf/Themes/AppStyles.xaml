<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============ COLOR PALETTE ============ -->
    <Color x:Key="C.Bg">#FFF7F8FB</Color>
    <Color x:Key="C.Sidebar">#FF111827</Color>
    <Color x:Key="C.SidebarHover">#FF1F2937</Color>
    <Color x:Key="C.SidebarActive">#FF2563EB</Color>
    <Color x:Key="C.SidebarText">#FFCBD5E1</Color>
    <Color x:Key="C.SidebarTextActive">#FFFFFFFF</Color>
    <Color x:Key="C.Card">#FFFFFFFF</Color>
    <Color x:Key="C.CardBorder">#FFE5E7EB</Color>
    <Color x:Key="C.Primary">#FF2563EB</Color>
    <Color x:Key="C.PrimaryHover">#FF1D4ED8</Color>
    <Color x:Key="C.Success">#FF16A34A</Color>
    <Color x:Key="C.SuccessSoft">#FFDCFCE7</Color>
    <Color x:Key="C.Warning">#FFF59E0B</Color>
    <Color x:Key="C.Danger">#FFDC2626</Color>
    <Color x:Key="C.DangerSoft">#FFFEE2E2</Color>
    <Color x:Key="C.TextPrimary">#FF0F172A</Color>
    <Color x:Key="C.TextSecondary">#FF64748B</Color>
    <Color x:Key="C.TextMuted">#FF94A3B8</Color>
    <Color x:Key="C.Accent2">#FFF59E0B</Color>
    <Color x:Key="C.Accent3">#FF8B5CF6</Color>

    <SolidColorBrush x:Key="B.Bg" Color="{StaticResource C.Bg}"/>
    <SolidColorBrush x:Key="B.Sidebar" Color="{StaticResource C.Sidebar}"/>
    <SolidColorBrush x:Key="B.SidebarHover" Color="{StaticResource C.SidebarHover}"/>
    <SolidColorBrush x:Key="B.SidebarActive" Color="{StaticResource C.SidebarActive}"/>
    <SolidColorBrush x:Key="B.SidebarText" Color="{StaticResource C.SidebarText}"/>
    <SolidColorBrush x:Key="B.SidebarTextActive" Color="{StaticResource C.SidebarTextActive}"/>
    <SolidColorBrush x:Key="B.Card" Color="{StaticResource C.Card}"/>
    <SolidColorBrush x:Key="B.CardBorder" Color="{StaticResource C.CardBorder}"/>
    <SolidColorBrush x:Key="B.Primary" Color="{StaticResource C.Primary}"/>
    <SolidColorBrush x:Key="B.PrimaryHover" Color="{StaticResource C.PrimaryHover}"/>
    <SolidColorBrush x:Key="B.Success" Color="{StaticResource C.Success}"/>
    <SolidColorBrush x:Key="B.SuccessSoft" Color="{StaticResource C.SuccessSoft}"/>
    <SolidColorBrush x:Key="B.Warning" Color="{StaticResource C.Warning}"/>
    <SolidColorBrush x:Key="B.Danger" Color="{StaticResource C.Danger}"/>
    <SolidColorBrush x:Key="B.DangerSoft" Color="{StaticResource C.DangerSoft}"/>
    <SolidColorBrush x:Key="B.TextPrimary" Color="{StaticResource C.TextPrimary}"/>
    <SolidColorBrush x:Key="B.TextSecondary" Color="{StaticResource C.TextSecondary}"/>
    <SolidColorBrush x:Key="B.TextMuted" Color="{StaticResource C.TextMuted}"/>
    <SolidColorBrush x:Key="B.Accent2" Color="{StaticResource C.Accent2}"/>
    <SolidColorBrush x:Key="B.Accent3" Color="{StaticResource C.Accent3}"/>

    <FontFamily x:Key="F.Default">Segoe UI</FontFamily>

    <!-- ============ TYPOGRAPHY ============ -->
    <Style x:Key="T.H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Default}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextPrimary}"/>
    </Style>
    <Style x:Key="T.H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Default}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextPrimary}"/>
    </Style>
    <Style x:Key="T.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Default}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextPrimary}"/>
    </Style>
    <Style x:Key="T.Muted" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Default}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextSecondary}"/>
    </Style>
    <Style x:Key="T.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Default}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextSecondary}"/>
    </Style>
    <Style x:Key="T.Stat" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Default}"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextPrimary}"/>
    </Style>

    <!-- ============ CARD ============ -->
    <Style x:Key="S.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#FF000000" Opacity="0.05" BlurRadius="14" ShadowDepth="2"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ BUTTONS ============ -->
    <Style x:Key="S.PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource B.Primary}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Default}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="root" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{StaticResource B.PrimaryHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Background" Value="{StaticResource B.TextMuted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="S.SuccessButton" TargetType="Button" BasedOn="{StaticResource S.PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource B.Success}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="22,14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="root" Background="{TemplateBinding Background}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="Background" Value="#FF15803D"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Background" Value="{StaticResource B.TextMuted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="S.GhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Default}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="Background" Value="#FFF1F5F9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ SIDEBAR NAV ITEM ============ -->
    <Style x:Key="S.NavItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource B.SidebarText}"/>
        <Setter Property="Padding" Value="18,12"/>
        <Setter Property="Margin" Value="10,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="root" Background="{TemplateBinding Background}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{StaticResource B.SidebarHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{StaticResource B.SidebarActive}"/>
                            <Setter Property="Foreground" Value="{StaticResource B.SidebarTextActive}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ INPUTS ============ -->
    <Style x:Key="S.TextBox" TargetType="TextBox">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Default}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextPrimary}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Padding="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="S.ComboBox" TargetType="ComboBox">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinHeight" Value="32"/>
    </Style>

    <Style x:Key="S.RadioButton" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource F.Default}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextPrimary}"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="S.CheckBox" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource F.Default}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextPrimary}"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- ============ DATAGRID ============ -->
    <Style x:Key="S.DataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource B.CardBorder}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeight" Value="32"/>
        <Setter Property="ColumnHeaderHeight" Value="36"/>
        <Setter Property="AlternatingRowBackground" Value="#FFF9FAFB"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Default}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#FFF1F5F9"/>
                    <Setter Property="Foreground" Value="{StaticResource B.TextSecondary}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="BorderBrush" Value="{StaticResource B.CardBorder}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="10,6"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ SCROLLBAR (slim) ============ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- ============ PROGRESSBAR ============ -->
    <Style x:Key="S.Progress" TargetType="ProgressBar">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Background" Value="#FFE5E7EB"/>
        <Setter Property="Foreground" Value="{StaticResource B.Primary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="4" HorizontalAlignment="Left"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
