<Window x:Class="DSSAppWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DSS Studio — WEKA Sınıflandırma" Height="780" Width="1240"
        MinHeight="640" MinWidth="1040"
        Background="{StaticResource B.Bg}"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource F.Default}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ SIDEBAR ============ -->
        <Border Grid.Column="0" Background="{StaticResource B.Sidebar}">
            <DockPanel LastChildFill="True">

                <!-- Brand -->
                <Border DockPanel.Dock="Top" Padding="22,24,22,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="8"
                                    Background="{StaticResource B.SidebarActive}">
                                <TextBlock Text="DS" Foreground="White" FontWeight="Bold"
                                           FontSize="14" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="DSS Studio" Foreground="White"
                                           FontWeight="Bold" FontSize="15"/>
                                <TextBlock Text="WEKA Classifier Lab" Foreground="#FF94A3B8"
                                           FontSize="10"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Bottom info -->
                <Border DockPanel.Dock="Bottom" Padding="22,16">
                    <StackPanel>
                        <Rectangle Height="1" Fill="#FF1E293B" Margin="0,0,0,14"/>
                        <TextBlock Text="Project-I" Foreground="#FF94A3B8" FontSize="10"/>
                        <TextBlock Text="Karar Destek Sistemleri" Foreground="#FFCBD5E1"
                                   FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Nav -->
                <ListBox x:Name="navList" Background="Transparent" BorderThickness="0"
                         SelectionChanged="navList_SelectionChanged"
                         ItemContainerStyle="{StaticResource S.NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Tag="0" IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" FontSize="16" Width="26"/>
                            <TextBlock Text="Veri Seti" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="16" Width="26"/>
                            <TextBlock Text="Algoritmalar" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="16" Width="26"/>
                            <TextBlock Text="Sonuçlar" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎯" FontSize="16" Width="26"/>
                            <TextBlock Text="Tahmin" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============ CONTENT AREA ============ -->
        <DockPanel Grid.Column="1" LastChildFill="True">

            <!-- TOP BAR -->
            <Border DockPanel.Dock="Top" Background="White" Height="64"
                    BorderBrush="{StaticResource B.CardBorder}" BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="lblPageTitle" Text="Veri Seti" Style="{StaticResource T.H1}"/>
                        <TextBlock x:Name="lblPageSub" Text="Bir .arff veya .csv dosyası yükleyin"
                                   Style="{StaticResource T.Muted}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="datasetChip" Background="#FFEFF6FF" CornerRadius="14"
                                Padding="12,6" Margin="0,0,12,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📂" Margin="0,0,6,0"/>
                                <TextBlock x:Name="lblChipDataset" Foreground="#FF1D4ED8"
                                           FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="statusChip" Background="#FFF1F5F9" CornerRadius="14"
                                Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="statusDot" Width="8" Height="8" Fill="#FF16A34A"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="lblStatus" Text="Hazır" FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource B.TextPrimary}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PAGES (only one visible) -->
            <Grid>

                <!-- ===================== PAGE 1: DATASET ===================== -->
                <Grid x:Name="page0" Margin="28,22,28,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- File picker card -->
                    <Border Style="{StaticResource S.Card}" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="VERİ SETİ DOSYASI" Style="{StaticResource T.Label}"/>
                                <TextBox x:Name="txtPath" Style="{StaticResource S.TextBox}"
                                         IsReadOnly="True" Margin="0,8,16,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Gözat" Style="{StaticResource S.PrimaryButton}"
                                    VerticalAlignment="Bottom" Click="btnBrowse_Click"/>
                        </Grid>
                    </Border>

                    <!-- Summary + Details -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Summary card -->
                        <Border Style="{StaticResource S.Card}" Margin="0,0,18,0">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Text="ÖZET"
                                           Style="{StaticResource T.Label}" Margin="0,0,0,14"/>

                                <UniformGrid DockPanel.Dock="Top" Rows="2" Columns="2"
                                             Margin="0,0,0,18">
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock x:Name="statInstances" Text="0"
                                                   Style="{StaticResource T.Stat}"/>
                                        <TextBlock Text="örnek" Style="{StaticResource T.Muted}"/>
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,8">
                                        <TextBlock x:Name="statAttributes" Text="0"
                                                   Style="{StaticResource T.Stat}"/>
                                        <TextBlock Text="öznitelik" Style="{StaticResource T.Muted}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock x:Name="statClasses" Text="0"
                                                   Style="{StaticResource T.Stat}"
                                                   Foreground="{StaticResource B.Primary}"/>
                                        <TextBlock Text="sınıf" Style="{StaticResource T.Muted}"/>
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock x:Name="statMissing" Text="0"
                                                   Style="{StaticResource T.Stat}"
                                                   Foreground="{StaticResource B.Warning}"/>
                                        <TextBlock Text="eksik değer" Style="{StaticResource T.Muted}"/>
                                    </StackPanel>
                                </UniformGrid>

                                <Rectangle DockPanel.Dock="Top" Height="1"
                                           Fill="{StaticResource B.CardBorder}" Margin="0,0,0,14"/>

                                <TextBlock DockPanel.Dock="Top" Text="SINIF DAĞILIMI"
                                           Style="{StaticResource T.Label}" Margin="0,0,0,10"/>

                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="classDistList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}"
                                                                   Style="{StaticResource T.Body}"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding CountText}"
                                                                   Style="{StaticResource T.Muted}"/>
                                                    </Grid>
                                                    <Border Grid.Row="1" Background="#FFE5E7EB"
                                                            CornerRadius="3" Height="6"
                                                            Margin="0,5,0,0">
                                                        <Border Background="{StaticResource B.Primary}"
                                                                CornerRadius="3"
                                                                HorizontalAlignment="Left"
                                                                Width="{Binding BarWidth}"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- Details card -->
                        <Border Grid.Column="1" Style="{StaticResource S.Card}">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                                    <Button x:Name="tabAttrBtn" Content="Öznitelikler"
                                            Style="{StaticResource S.GhostButton}"
                                            Click="ShowAttrsTab_Click" Margin="0,0,8,0"
                                            BorderBrush="{StaticResource B.Primary}"
                                            Foreground="{StaticResource B.Primary}"/>
                                    <Button x:Name="tabPreviewBtn" Content="Önizleme"
                                            Style="{StaticResource S.GhostButton}"
                                            Click="ShowPreviewTab_Click"/>
                                </StackPanel>

                                <DataGrid x:Name="dgAttributes" Style="{StaticResource S.DataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50"/>
                                        <DataGridTextColumn Header="ÖZNİTELİK" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="TİP" Binding="{Binding Type}" Width="120"/>
                                        <DataGridTextColumn Header="DEĞERLER" Binding="{Binding ValuesText}" Width="2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DataGrid x:Name="dgPreview" Style="{StaticResource S.DataGrid}"
                                          AutoGenerateColumns="True" Visibility="Collapsed"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===================== PAGE 2: ALGORITHMS ===================== -->
                <Grid x:Name="page1" Margin="28,22,28,28" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Evaluation method card -->
                    <Border Style="{StaticResource S.Card}" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="DEĞERLENDİRME YÖNTEMİ" Style="{StaticResource T.Label}"
                                           Margin="0,0,0,12"/>
                                <RadioButton x:Name="radSplit" Style="{StaticResource S.RadioButton}"
                                             Content="Yüzdelik Ayırma (Train/Test Split)" IsChecked="True"
                                             GroupName="EvalMethod"/>
                                <RadioButton x:Name="radCV" Style="{StaticResource S.RadioButton}"
                                             Content="10-Kat Çapraz Doğrulama (10-Fold CV)"
                                             GroupName="EvalMethod"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="EĞİTİM ORANI (%)" Style="{StaticResource T.Label}"
                                           Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="sliSplit" Minimum="10" Maximum="95" Value="66"
                                            VerticalAlignment="Center"
                                            TickFrequency="5" IsSnapToTickEnabled="True"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=sliSplit, Path=Value, StringFormat={}{0:F0}%}"
                                               Style="{StaticResource T.H2}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="24,0,0,0">
                                <TextBlock Text="SEED" Style="{StaticResource T.Label}" Margin="0,0,0,12"/>
                                <TextBox x:Name="txtSeed" Style="{StaticResource S.TextBox}"
                                         Width="80" Text="1"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Algorithm list + description -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource S.Card}" Margin="0,0,18,0">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ALGORİTMALAR" Style="{StaticResource T.Label}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Tümü" Style="{StaticResource S.GhostButton}"
                                                Margin="0,0,6,0" Click="btnSelectAll_Click"/>
                                        <Button Content="Hiçbiri" Style="{StaticResource S.GhostButton}"
                                                Click="btnSelectNone_Click"/>
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="algoItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="Transparent" Padding="6"
                                                        Margin="0,2" CornerRadius="6"
                                                        MouseLeftButtonUp="AlgoRow_Click"
                                                        Cursor="Hand"
                                                        Tag="{Binding Descriptor}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  Style="{StaticResource S.CheckBox}"
                                                                  VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                                   Style="{StaticResource T.Body}"
                                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                        <Border Grid.Column="2" CornerRadius="10" Padding="8,2"
                                                                Background="{Binding FamilyBrush}">
                                                            <TextBlock Text="{Binding FamilyText}" FontSize="10"
                                                                       FontWeight="SemiBold" Foreground="White"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource S.Card}">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Text="ALGORİTMA DETAYI"
                                           Style="{StaticResource T.Label}" Margin="0,0,0,14"/>
                                <StackPanel x:Name="algoDetailPanel">
                                    <TextBlock x:Name="lblAlgoName" Text="(soldan bir algoritma seçin)"
                                               Style="{StaticResource T.H2}" Margin="0,0,0,16"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Aile" Style="{StaticResource T.Muted}"/>
                                        <TextBlock x:Name="lblAlgoFamily" Grid.Column="1"
                                                   Style="{StaticResource T.Body}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Önişleme" Style="{StaticResource T.Muted}"/>
                                        <TextBlock x:Name="lblAlgoPrep" Grid.Column="1"
                                                   Style="{StaticResource T.Body}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="WEKA sınıfı" Style="{StaticResource T.Muted}"/>
                                        <TextBlock x:Name="lblAlgoClass" Grid.Column="1"
                                                   Style="{StaticResource T.Body}" FontFamily="Consolas"/>
                                    </Grid>
                                    <Border Background="#FFF8FAFC" CornerRadius="6" Padding="14">
                                        <TextBlock x:Name="lblAlgoDesc" Style="{StaticResource T.Body}"
                                                   TextWrapping="Wrap" LineHeight="20"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Run bar -->
                    <Border Grid.Row="2" Style="{StaticResource S.Card}" Margin="0,18,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="lblRunStatus" Text="Hazır — algoritmaları seçip çalıştırın"
                                           Style="{StaticResource T.Body}"/>
                                <ProgressBar x:Name="prog" Style="{StaticResource S.Progress}"
                                             Margin="0,8,16,0" Visibility="Collapsed"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="btnRun" Content="▶  ÇALIŞTIR"
                                    Style="{StaticResource S.SuccessButton}"
                                    Click="btnRun_Click"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===================== PAGE 3: RESULTS ===================== -->
                <Grid x:Name="page2" Margin="28,22,28,28" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="280"/>
                    </Grid.RowDefinitions>

                    <!-- Hero "Best" card -->
                    <Border Margin="0,0,0,18" CornerRadius="12" Padding="24"
                            BorderBrush="{StaticResource B.CardBorder}" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF1E40AF" Offset="0"/>
                                <GradientStop Color="#FF2563EB" Offset="0.5"/>
                                <GradientStop Color="#FF16A34A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#FF1E40AF" Opacity="0.25" BlurRadius="20" ShadowDepth="0"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="🏆" FontSize="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="EN İYİ ALGORİTMA" Foreground="#FFFFFFFF" FontSize="11"
                                               FontWeight="SemiBold" Opacity="0.85"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="lblBestName" Text="(henüz çalıştırılmadı)"
                                           Foreground="White" FontSize="26" FontWeight="Bold"/>
                                <TextBlock x:Name="lblBestSub" Text=""
                                           Foreground="#FFE0F2FE" FontSize="13" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="💾  Modeli Kaydet" Click="btnSaveModel_Click"
                                        Background="#33FFFFFF" Foreground="White" BorderThickness="0"
                                        Padding="16,10" Margin="0,0,8,0" Cursor="Hand"
                                        FontWeight="SemiBold">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="r" Background="{TemplateBinding Background}"
                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="r" Property="Background"
                                                            Value="#55FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Content="⬇  CSV Dışa Aktar" Click="btnExport_Click"
                                        Background="#33FFFFFF" Foreground="White" BorderThickness="0"
                                        Padding="16,10" Cursor="Hand" FontWeight="SemiBold">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="r" Background="{TemplateBinding Background}"
                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="r" Property="Background"
                                                            Value="#55FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Results table card -->
                    <Border Grid.Row="1" Style="{StaticResource S.Card}">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="TÜM SONUÇLAR"
                                       Style="{StaticResource T.Label}" Margin="0,0,0,12"/>
                            <DataGrid x:Name="dgResults" Style="{StaticResource S.DataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ALGORİTMA" Binding="{Binding AlgorithmName}" Width="2*"/>
                                    <DataGridTextColumn Header="DOĞRU/TOPLAM" Binding="{Binding CountsText}" Width="*"/>
                                    <DataGridTextColumn Header="ACCURACY" Binding="{Binding AccuracyText}" Width="*"/>
                                    <DataGridTextColumn Header="PRECISION" Binding="{Binding PrecisionText}" Width="*"/>
                                    <DataGridTextColumn Header="RECALL" Binding="{Binding RecallText}" Width="*"/>
                                    <DataGridTextColumn Header="F-MEASURE" Binding="{Binding FMeasureText}" Width="*"/>
                                    <DataGridTextColumn Header="KAPPA" Binding="{Binding KappaText}" Width="*"/>
                                    <DataGridTextColumn Header="SÜRE" Binding="{Binding TimeText}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- Chart card -->
                    <Border Grid.Row="2" Style="{StaticResource S.Card}" Margin="0,18,0,0">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ACCURACY KARŞILAŞTIRMASI"
                                           Style="{StaticResource T.Label}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Rectangle Width="12" Height="12" Fill="{StaticResource B.Primary}"
                                               RadiusX="2" RadiusY="2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Accuracy" Style="{StaticResource T.Muted}" Margin="0,0,16,0"/>
                                    <Rectangle Width="12" Height="12" Fill="{StaticResource B.Accent2}"
                                               RadiusX="2" RadiusY="2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="F-Measure (×100)" Style="{StaticResource T.Muted}"/>
                                </StackPanel>
                            </Grid>
                            <Canvas x:Name="chartCanvas" Background="Transparent" ClipToBounds="True"
                                    SizeChanged="chartCanvas_SizeChanged"/>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ===================== PAGE 4: PREDICT ===================== -->
                <Grid x:Name="page3" Margin="28,22,28,28" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Active model card -->
                    <Border Style="{StaticResource S.Card}" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="AKTİF MODEL" Style="{StaticResource T.Label}"/>
                                <TextBlock x:Name="lblActiveModel"
                                           Text="Model yüklü değil. Önce algoritmaları çalıştırın ya da diskten yükleyin."
                                           Style="{StaticResource T.Body}" Margin="0,8,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="📂  Diskten Yükle"
                                    Style="{StaticResource S.GhostButton}"
                                    VerticalAlignment="Center" Click="btnLoadModel_Click"/>
                        </Grid>
                    </Border>

                    <!-- Inputs -->
                    <Border Grid.Row="1" Style="{StaticResource S.Card}">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="ÖZNİTELİK DEĞERLERİ"
                                       Style="{StaticResource T.Label}" Margin="0,0,0,12"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="predictInputs"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Predict button + result -->
                    <Border Grid.Row="2" Margin="0,18,0,0" CornerRadius="12" Padding="20"
                            BorderBrush="{StaticResource B.CardBorder}" BorderThickness="1"
                            Background="{StaticResource B.Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="🎯  TAHMİN ET" Style="{StaticResource S.SuccessButton}"
                                    Click="btnPredict_Click"/>
                            <Border Grid.Column="1" Margin="20,0,0,0" Padding="20,12" CornerRadius="8"
                                    Background="{StaticResource B.SuccessSoft}"
                                    VerticalAlignment="Stretch">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="TAHMİN" Style="{StaticResource T.Label}"
                                               Foreground="#FF15803D"/>
                                    <TextBlock x:Name="lblPredictionResult" Text="—"
                                               FontSize="22" FontWeight="Bold"
                                               Foreground="{StaticResource B.Success}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </DockPanel>
    </Grid>
</Window>
